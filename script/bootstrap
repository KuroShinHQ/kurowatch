#!/usr/bin/env bash
# Scripts to Rule Them All: script/bootstrap (kurowatch)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$ROOT/backend/requirements.txt" ]; then
  echo "[bootstrap] kurowatch backend requirements kuruluyor..."
  python3 -m pip install -r "$ROOT/backend/requirements.txt"
fi

echo "[bootstrap] pytest kurulu mu kontrol ediliyor..."
python3 -m pip install --quiet pytest pytest-asyncio

if [ -d "$ROOT/frontend" ] && [ -f "$ROOT/frontend/package.json" ]; then
  echo "[bootstrap] frontend npm kuruluyor..."
  (cd "$ROOT/frontend" && npm install --silent)
fi

echo "[bootstrap] tamam"
